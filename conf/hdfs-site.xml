<?xml version="1.0"?>
<configuration>
  <property><name>dfs.replication</name><value>2</value></property>
  <!-- Tiny blocks so a few-MB file spans several blocks (and several map tasks). -->
  <property><name>dfs.blocksize</name><value>2m</value></property>
  <property><name>dfs.namenode.name.dir</name><value>/hadoop/dfs/name</value></property>
  <property><name>dfs.datanode.data.dir</name><value>/hadoop/dfs/data</value></property>
  <property><name>dfs.permissions.enabled</name><value>false</value></property>
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
  <!-- Declare a datanode dead after ~1 min instead of the default ~10.5 min. -->
  <property><name>dfs.heartbeat.interval</name><value>3</value></property>
  <property><name>dfs.namenode.heartbeat.recheck-interval</name><value>15000</value></property>
</configuration>
